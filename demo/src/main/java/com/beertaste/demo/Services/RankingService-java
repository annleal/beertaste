@Service
public class RankingService {

    @Autowired
    private EvaluacionRepository evaluacionRepository;

    public List<CervezaRankingDTO> topMejorValoradas() {
        return evaluacionRepository.findTop5ByPromedioPuntuacion();
    }

    public List<CervezaRankingDTO> topMasConsumidas() {
        return evaluacionRepository.findTop5MasEvaluadas();
    }

    public List<CervezaRankingDTO> topCalidadPrecio() {
        return evaluacionRepository.findTop5CalidadPrecio();
    }
}
